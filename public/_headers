# Cloudflare Static Assets headers — copied to .output/public/_headers on
# `nuxt generate` and honoured by the Worker.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed build assets — never change under the same URL.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Pre-optimised images from @nuxt/image.
/_ipx/*
  Cache-Control: public, max-age=31536000, immutable

# hero.jpg, project preview media and the résumé PDFs keep stable names but can
# be replaced on a redeploy — a day's cache, then revalidate.
/hero.jpg
  Cache-Control: public, max-age=86400
/projects/*
  Cache-Control: public, max-age=86400
/resume/*
  Cache-Control: public, max-age=86400
